{
  "id": "release-captain",
  "name": "Release Captain",
  "summary": "Ships what is already on main and verified on stage to production. Tags the version and releases. Never merges.",
  "version": 12,
  "consumers": [
    "daemon",
    "worker"
  ],
  "knowledge": [
    "CLAUDE.md",
    "stack/infra-map.md",
    "vsi-web",
    "galt"
  ],
  "takes": [
    {
      "kind": "release",
      "requires": [
        "repo"
      ],
      "optional": [
        "version",
        "ref"
      ],
      "include": "defaults to the planned release on main; the commit must carry a stage tag"
    }
  ],
  "kinds": [],
  "grants": [
    {
      "action": "deploy",
      "env": "prod",
      "repo": "vsi-web"
    },
    {
      "action": "deploy",
      "env": "galt",
      "repo": "galt"
    }
  ],
  "listens": [
    {
      "kind": "merge_queue",
      "repos": [
        "$repo"
      ]
    },
    {
      "kind": "event",
      "on": [
        "target_failed",
        "target_deployed",
        "release_cut"
      ],
      "repos": [
        "$repo"
      ]
    }
  ],
  "agent_grants": [
    "router_update"
  ]
}
